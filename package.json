{
  "name": "dsh-codebuddy-provider",
  "version": "0.1.0",
  "description": "CodeBuddy API-key model provider for DeepSeek Harness, following Codeg environment configuration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesmou/dsh-codebuddy-provider.git"
  },
  "homepage": "https://github.com/milesmou/dsh-codebuddy-provider#readme",
  "bugs": { "url": "https://github.com/milesmou/dsh-codebuddy-provider/issues" },
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "files": ["lib", "cordis.patch.yml", "examples", "README.md", "LICENSE"],
  "keywords": ["dsh-plugin", "deepseek-harness", "codebuddy", "llm"],
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.2" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "openai": "7.45.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
